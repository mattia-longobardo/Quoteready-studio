{
  "name": "quoteredy",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @quoteredy/web",
    "build": "npm run build -w @quoteredy/web",
    "start": "npm run start -w @quoteredy/web",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"apps/web/**/*.{ts,tsx,css}\" \"packages/*/src/**/*.ts\" \"packages/*/tests/**/*.ts\" \"*.{json,mjs}\"",
    "format:check": "prettier --check \"apps/web/**/*.{ts,tsx,css}\" \"packages/*/src/**/*.ts\" \"packages/*/tests/**/*.ts\" \"*.{json,mjs}\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test && npm run format:check"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "minimatch": "10.2.6",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
