# Host pubblico servito da Traefik.
QUOTEREADY_HOST=quoteready.longobardo.me

# Fuso orario standard dello stack Docker.
TZ=Europe/Rome

# Public client ID returned when you create the Zoo OAuth App.
ZOO_OAUTH_CLIENT_ID=

# Must exactly match a redirect URI registered on the Zoo OAuth App.
ZOO_OAUTH_REDIRECT_URI=https://quoteready.longobardo.me/api/auth/callback

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
QUOTE_READY_SESSION_SECRET=

# The Zoo API token for the library/CAD upload is NOT configured here: each
# user stores their personal token in the in-app Settings page.

# --- Workspace persistence -------------------------------------------------
# postgres (default in compose): dedicated quoteredy-db service, one JSONB row
# per user. Set to json to fall back to the single-file store under ./data.
QUOTEREADY_STORAGE_DRIVER=postgres
QUOTEREADY_DB_USER=quoteredy
QUOTEREADY_DB_NAME=quoteredy
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
DB_QUOTEREADY_PASSWORD=
# Only needed outside compose (compose builds the URL from the values above):
# QUOTEREADY_DATABASE_URL=postgresql://quoteredy:<password>@quoteredy-db:5432/quoteredy

# --- Blob storage (uploaded CAD/drawings) ----------------------------------
# s3 (default in compose): dedicated quoteredy-minio service. Set to fs to
# store under ./data/blobs instead.
QUOTEREADY_BLOB_DRIVER=s3
# Archive the analysed CAD + drawing next to each report.
QUOTEREADY_PERSIST_UPLOADS=true
QUOTEREADY_S3_REGION=us-east-1
QUOTEREADY_S3_BUCKET=quoteredy
# MinIO root credentials; the app reuses them as S3 access keys.
QUOTEREADY_MINIO_ROOT_USER=quoteredy-admin
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
QUOTEREADY_MINIO_ROOT_PASSWORD=
# For an external S3 endpoint instead of the bundled MinIO, override in compose:
# QUOTEREADY_S3_ENDPOINT=  QUOTEREADY_S3_ACCESS_KEY_ID=  QUOTEREADY_S3_SECRET_ACCESS_KEY=
